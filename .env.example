# Copy to .env and fill in. .env is git-ignored; never commit real values.

# n8n payment-request webhook (POST /api/pay). Server-side only; never sent to the browser.
# Header the n8n webhook expects for authentication (e.g. X-Api-Key) and its secret value.
N8N_HEADER_NAME=
N8N_HEADER_VALUE=
# Identifier of this kiosk; added to every forwarded request as "kioskId".
KIOSK_ID=

# PayMongo (use test-mode keys for development).
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Optional: public HTTPS origin used as the wallet return URL / required behind ngrok.
FBC_PUBLIC_BASE_URL=
# Optional: set to true only when running behind an HTTPS reverse proxy such as ngrok.
# FBC_TRUST_HTTPS_PROXY=true
